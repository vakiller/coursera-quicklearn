filters:
  and:
    - file.inFolder("Coursera")
views:
  - type: table
    name: Tiến độ module
    filters:
      and:
        - file.basename == "_study"
    order:
      - file.name
      - course
      - module
      - status
      - pretest_score
      - practice_score
      - last_studied
    sort:
      - property: course
        direction: ASC
      - property: module
        direction: ASC
  - type: table
    name: Kết quả luyện đề
    filters:
      and:
        - note.type == "practice"
    order:
      - file.name
      - course
      - module
      - kind
      - score
      - graded_at
